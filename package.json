{
  "name": "jassen",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:server": "npm run dev --workspace apps/server",
    "test:engine": "npm run test --workspace packages/game-engine",
    "build": "npm run build --workspace packages/game-engine && npm run build --workspace apps/server && npm run build --workspace apps/web"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
